{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "New API Desktop",
  "version": "1.1.3",
  "identifier": "com.newapi.desktop",
  "build": {
    "frontendDist": "../.tauri-dist",
    "beforeDevCommand": "npm run prepare:tauri-assets",
    "beforeBuildCommand": "npm run prepare:tauri-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "New API Desktop",
        "width": 560,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http: https:; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MUML",
    "copyright": "Copyright © 2026 QuantumNous; maintained by MUML",
    "shortDescription": "Cross-platform New API client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
